{
  "id": "addon.stack-bench",
  "name": "Stack Bench",
  "version": "0.1.0",
  "author": "KyaniteLabs",
  "category": "tool",
  "sdkVersion": "0.1.0",
  "description": "Measures a local llama-server endpoint honestly: prefill and decode tokens-per-second with true-token prompt sizing and an ambient-noise A/B check. Runs entirely on your machine; results are plain JSON files you own.",
  "runtimeType": "local-service",
  "surfaces": [],
  "requestedCapabilities": [
    {
      "capability": "network",
      "granted": false,
      "scope": "self",
      "revocationBehavior": "hard-stop"
    }
  ],
  "provenance": {
    "tier": "sideloaded-unverified",
    "verificationState": "unverified",
    "signed": false
  },
  "runtimeIsolation": {
    "boundary": "host-mediated-service",
    "supportsDegradedMode": true,
    "requiresReviewedGrant": true
  },
  "grantPresets": [
    {
      "id": "stack-bench-local",
      "label": "Local benchmark runs",
      "description": "Allow Stack Bench to open connections to the local llama-server endpoint you configure, to run prefill/decode measurements.",
      "grants": [
        {
          "capability": "network",
          "granted": true,
          "scope": "self",
          "revocationBehavior": "hard-stop"
        }
      ]
    }
  ],
  "providerRequirements": {
    "sharedProfiles": [],
    "supportsPrivateCredentials": true
  },
  "systemSlots": [],
  "archiveIntegration": {
    "readScopes": [],
    "intakeWriteScopes": [],
    "canRequestIngest": false,
    "canWriteKnowledgePages": false
  },
  "health": {
    "strategy": "http-json-status"
  },
  "service": {
    "protocol": "http-json",
    "entrypoint": "http://127.0.0.1:4889",
    "healthCommand": "stackbench.status"
  },
  "tools": [
    {
      "name": "stackbench.status",
      "description": "Report service version, busy state, and the most recent run id.",
      "requiredCapabilities": ["network"],
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "version": { "type": "string" },
          "busy": { "type": "boolean" },
          "last_run_id": { "type": ["string", "null"] }
        }
      },
      "audit": { "logRequest": true, "logResult": true, "artifactTypes": ["log"] },
      "requiresHumanApproval": false
    },
    {
      "name": "stackbench.run",
      "description": "Start one benchmark job against a local llama-server endpoint. Returns a run id immediately; poll stackbench.results. The API key, if the server uses one, is read from the STACKBENCH_API_KEY environment variable and is never accepted as a request field.",
      "requiredCapabilities": ["network"],
      "inputSchema": {
        "type": "object",
        "properties": {
          "endpoint_url": { "type": "string", "description": "Base URL of the local llama-server, loopback only unless STACKBENCH_ALLOW_REMOTE=1" },
          "run_id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9._-]+$" },
          "prompt_tokens": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 200000 }, "maxItems": 8 },
          "rounds": { "type": "integer", "minimum": 1, "maximum": 10 }
        },
        "required": ["endpoint_url"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" },
          "state": { "type": "string", "enum": ["running", "done", "failed"] }
        }
      },
      "audit": { "logRequest": true, "logResult": true, "artifactTypes": ["log"] },
      "requiresHumanApproval": false
    },
    {
      "name": "stackbench.results",
      "description": "Fetch the summary of a run (latest if no run id given): prefill/decode tokens-per-second, ambient pairs, wall times.",
      "requiredCapabilities": ["network"],
      "inputSchema": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9._-]+$" }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" },
          "state": { "type": "string", "enum": ["running", "done", "failed"] },
          "summary_path": { "type": "string" },
          "summary": { "type": "object" }
        }
      },
      "audit": { "logRequest": true, "logResult": true, "artifactTypes": ["log"] },
      "requiresHumanApproval": false
    }
  ],
  "installHooks": {
    "onInstall": "start-stack-bench-service"
  },
  "compatibility": {
    "shellVersion": "^0.1.0",
    "platforms": ["macOS", "linux", "windows"]
  }
}
